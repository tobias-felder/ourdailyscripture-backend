# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/ourdailyscripture

# JWT Secret (generate a random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Admin Setup Key (for creating first admin)
ADMIN_SETUP_KEY=your-setup-key-change-this

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Email Configuration (choose one method)

# Option 1: Gmail
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=OurDailyScripture <your-email@gmail.com>

# Option 2: SMTP (alternative)
# EMAIL_SERVICE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# EMAIL_FROM=OurDailyScripture <noreply@ourdailyscripture.com>

# Admin notifications
ADMIN_EMAIL=admin@ourdailyscripture.com
ADMIN_URL=https://admin.ourdailyscripture.com

# Printify (optional)
PRINTIFY_API_KEY=your-printify-api-key
PRINTIFY_SHOP_ID=your-shop-id

